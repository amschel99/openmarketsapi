{
  "name": "openmarkets-api",
  "version": "0.1.0",
  "description": "Typed REST wrapper over the openmarkets.live (Paycrest) dashboard feed: corridor liquidity and success rates.",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "deploy": "wrangler deploy"
  },
  "engines": { "node": ">=18" },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0"
  }
}
